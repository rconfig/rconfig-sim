package views

import ui "github.com/rcfg-sim/rcfg-sim/internal/ui/web/views/components"

// BuildPage is the Build screen (10.4): regenerate the fleet's configs with
// new per-model counts and seed, then restart onto them.
templ BuildPage(p Page, m BuildModel) {
	@Layout(p) {
		<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			<h1 class="text-2xl">Build</h1>
			<p class="text-muted">Regenerates every device config, then restarts the fleet one instance at a time.</p>
		</div>
		if m.NotAdopted != "" {
			@adoptionSteps(m)
		} else if m.Err != "" {
			<div class="mt-6">
				@ui.Toast(ui.ToastError, m.Err, nil)
			</div>
		} else {
			<div class="mt-6 grid gap-6 2xl:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
				<div class="flex flex-col gap-6">
					@liveBuild(m)
					@buildForm(m)
				</div>
				<div class="flex flex-col gap-6">
					@panel("Estimate", "What the build needs, worked out before anything is written.") {
						<div id="build-estimate" hx-post="/build/estimate" hx-trigger="load, input changed delay:300ms from:#build-form" hx-include="#build-form" hx-swap="innerHTML">
							<p class="text-muted">Working out the estimate…</p>
						</div>
					}
				</div>
			</div>
			<div id="build-job" class="mt-6">
				if m.Job != nil {
					@JobPanel(*m.Job)
				}
			</div>
		}
	}
}

templ adoptionSteps(m BuildModel) {
	@panel("Adopt this install first", "Builds need the data/ layout: each build in its own directory under "+m.DataDir+"/builds/, and a current symlink the instances read. This install is not on it yet.") {
		<p class="text-muted">Reason: { m.NotAdopted }</p>
		<p class="mt-3">On the simulator host, as root, once:</p>
		@ui.Code(templ.Attributes{"class": "mt-2"}) {
			{ "# from the rconfig-sim source checkout\nsudo make adopt-data\n# or, from an installed copy\nsudo bash /opt/rcfg-sim/deploy/adopt-data.sh\n\n# the UI needs write access to the data directory\nsudo make install-ui && sudo systemctl restart rcfg-sim-ui\n" }
		}
		<p class="mt-3 text-muted">It moves the current configs and manifest into the first build, points every instance's MANIFEST at { m.DataDir }/current/manifest.csv and leaves the instances running. Then restart them (Fleet, Rolling restart) and reload this page.</p>
	}
}

templ liveBuild(m BuildModel) {
	@panel("Live build", "") {
		if m.Live != nil {
			<dl class="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-3 gap-y-1">
				<dt class="text-muted">Build</dt><dd class="num">{ m.Live.Name }</dd>
				<dt class="text-muted">Created</dt><dd class="num">{ m.Live.Created }</dd>
				<dt class="text-muted">Devices</dt><dd class="num">{ itoa(m.Live.Count) }</dd>
				<dt class="text-muted">Seed</dt><dd class="num">{ m.Live.Seed }</dd>
				<dt class="text-muted">Distribution</dt><dd class="num break-all">{ m.Live.Distribution }</dd>
			</dl>
			if m.Live.Adopted {
				<p class="mt-2 text-xs text-muted">Adopted from a pre-UI install: its seed and distribution are not known, so the form starts from the generator's defaults.</p>
			}
		}
		<div class="mt-4 flex flex-wrap items-center gap-3 border-t border-line pt-3">
			if m.Previous != nil {
				<span class="text-muted">Previous build <span class="num text-fg">{ m.Previous.Name }</span> ({ itoa(m.Previous.Count) } devices)</span>
				@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": "/build/rollback", "hx-target": "#build-job", "hx-confirm": "Roll back to build " + m.Previous.Name + " and restart every instance?"}) {
					Roll back
				}
			} else {
				<span class="text-muted">No previous build to roll back to.</span>
			}
		</div>
	}
}

templ buildForm(m BuildModel) {
	@panel("New build", "") {
		<form id="build-form" hx-post="/build/run" hx-target="#build-job" hx-confirm="Generate a new build and restart every instance onto it?" class="flex flex-col gap-5">
			@ui.Field("Seed", "Same seed and counts, same configs (flag --seed).") {
				@ui.NumberInput(templ.Attributes{"name": "seed", "step": "1", "value": i64(m.Seed), "class": "w-40"})
			}
			<p class="text-muted">Devices per model. The total must be { itoa(m.MinCount) } to { itoa(m.MaxCount) } on { itoa(m.Instances) } instances of { itoa(m.PerIP) }: every instance needs at least one device; to run fewer, use Active devices on the Fleet screen.</p>
			for _, g := range m.Groups {
				<fieldset class="flex flex-col gap-1">
					<legend class="mb-2 font-medium">{ g.Name }</legend>
					for _, c := range g.Rows {
						@ui.CountRow(c)
					}
				</fieldset>
			}
			@ui.Actions("Generates a new build into its own directory, then restarts every instance onto it one at a time.") {
				@ui.Submit(ui.Primary, nil) {
					Build and restart
				}
			}
		</form>
	}
}

// EstimatePanel is the estimate for the form's current values.
templ EstimatePanel(m EstimateModel) {
	<div class="flex flex-col gap-3">
		<div>
			<div class="flex justify-between text-xs text-muted">
				<span>Devices by model</span>
				<span class="num">{ Thousands(m.Total) } devices</span>
			</div>
			<svg class="mt-1 h-4 w-full rounded-sm" viewBox="0 0 100 4" preserveAspectRatio="none" role="img" aria-label="Devices by model">
				<rect width="100" height="4" class="fill-panel-2"></rect>
				for _, b := range m.Bars {
					<rect x={ b.X } width={ b.W } height="4" class={ b.Class }><title>{ b.Model } { Thousands(b.Count) }</title></rect>
				}
			</svg>
			<ul class="mt-1 flex flex-wrap gap-x-3 text-xs">
				for _, b := range m.Bars {
					<li class="flex items-center gap-1"><svg class="size-2.5" viewBox="0 0 1 1" aria-hidden="true"><rect width="1" height="1" class={ b.Class }></rect></svg><span class="num">{ b.Model } { Thousands(b.Count) } ({ itoa(b.Pct) }%)</span></li>
				}
			</ul>
		</div>
		if m.Disk != "" {
			<dl class="grid grid-cols-[9rem_minmax(0,1fr)] gap-x-3 gap-y-1">
				<dt class="text-muted">Disk</dt><dd class="num">{ m.Disk }</dd>
				<dt class="text-muted">Free</dt><dd class={ "num", templ.KV("text-st-error", !m.Fits) }>{ m.Free }</dd>
				<dt class="text-muted">RAM (page cache)</dt><dd class="num">{ m.RAM }</dd>
				<dt class="text-muted">Generate</dt><dd class="num">{ m.Generate }</dd>
				<dt class="text-muted">Restart</dt><dd class="num">{ m.Restart }</dd>
			</dl>
		}
		if m.Unknowns {
			<p class="text-xs text-muted">The live build's settings are unknown (adopted), so other generator options use their defaults.</p>
		}
		if m.Err != "" {
			@ui.Toast(ui.ToastError, m.Err, nil)
		}
		if len(m.Steps) > 0 {
			<div>
				<p class="text-muted">Steps, as root, before building:</p>
				@ui.Code(templ.Attributes{"class": "mt-1"}) {
					for _, s := range m.Steps {
						{ s + "\n" }
					}
				}
			</div>
		}
		if m.Ready {
			<p class="text-st-ok">Ready to build.</p>
		}
	</div>
}

// JobPanel streams a build or rollback's log until it finishes.
templ JobPanel(m JobModel) {
	@ui.Panel(templ.Attributes{"aria-label": "Job"}) {
		<div class="flex items-baseline justify-between gap-3">
			<h2 class="text-lg capitalize">{ m.Kind } <span class="num text-sm text-muted">{ m.ID }</span></h2>
		</div>
		if m.Finished {
			@JobState(m)
			@ui.Code(templ.Attributes{"class": "mt-3"}) {
				for _, l := range m.Lines {
					{ l + "\n" }
				}
			}
		} else {
			<div hx-ext="sse" sse-connect={ "/build/jobs/" + m.ID + "/stream" } sse-close="done">
				<div sse-swap="state" hx-swap="innerHTML">
					<p class="mt-2 text-st-active">Running…</p>
				</div>
				@ui.Code(templ.Attributes{"class": "mt-3", "sse-swap": "line", "hx-swap": "beforeend"})
			</div>
		}
	}
}

// JobState is a finished job's outcome, with rollback offered when a
// failed build left the fleet on the new build.
templ JobState(m JobModel) {
	if m.Err == "" {
		<p class="mt-2 text-st-ok">Finished.</p>
	} else {
		<p class="mt-2 text-st-error" role="alert">{ m.Err }</p>
		if m.OfferRollback {
			<div class="mt-2">
				@ui.Button(ui.Primary, "", templ.Attributes{"hx-post": "/build/rollback", "hx-target": "#build-job", "hx-confirm": "Roll back to the previous build and restart every instance?"}) {
					Roll back
				}
			</div>
		}
	}
}
