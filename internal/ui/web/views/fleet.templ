package views

import (
	"github.com/rcfg-sim/rcfg-sim/internal/ui/fleet"
	ui "github.com/rcfg-sim/rcfg-sim/internal/ui/web/views/components"
)

// FleetPage is the Fleet (service control) screen (10.1).
templ FleetPage(p Page, m FleetModel) {
	@Layout(p) {
		<div class="flex items-baseline justify-between gap-4">
			<h1 class="text-2xl">Fleet</h1>
			<p class="text-muted">Changes apply to new sessions and are saved to each instance's env file.</p>
		</div>
		if m.Checklist != nil {
			@Checklist(*m.Checklist)
		}
		@FleetCards(m, false)
		<div class="mt-8 grid gap-6 xl:grid-cols-2">
			@activeForm(m)
			@delayForm(m)
			@capsForm(m)
			@fleetActions()
		</div>
	}
}

// FleetCards is the instance grid. It polls itself, and refreshes at once
// after any change (the fleet-changed event).
templ FleetCards(m FleetModel, oob bool) {
	<section
		id="fleet-cards"
		hx-get="/fleet/cards"
		hx-trigger={ "every " + m.Poll + ", fleet-changed from:body" }
		hx-swap="outerHTML"
		class="mt-6"
		aria-label="Instances"
	>
		if oob {
			@HealthPill(healthUp(m.Views), healthTotal(m.Views), true)
		}
		@rollingStatus(m.Rolling)
		if len(m.Views) == 0 {
			@ui.Empty("No instances found", "Each *.env file in the env directory is one instance. On a new host, sudo make setup creates them.") {
				<span></span>
			}
		}
		<div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(18rem,1fr))]">
			for _, v := range m.Views {
				@card(v)
			}
		</div>
	</section>
}

templ card(v fleet.View) {
	@ui.Panel(templ.Attributes{"class": "flex flex-col gap-3", "data-instance": v.Name, "data-status": string(v.Status)}) {
		<div class="flex items-start justify-between gap-2">
			<div>
				<h2 class="num text-base">{ v.ListenIP }</h2>
				<p class="num text-xs text-muted">ports { portRange(v) } · metrics { v.MetricsAddr }</p>
			</div>
			@ui.Pill(statusPill(v.Status), templ.Attributes{"class": "shrink-0"}) {
				{ statusLabel(v.Status) }
			}
		</div>
		if v.Status == fleet.StatusUp && v.State != nil {
			<div>
				<div class="flex justify-between text-xs">
					<span class="text-muted">Sessions</span>
					<span class="num">{ i64(v.State.ActiveSessions) } / { i64(v.State.MaxSessions) }</span>
				</div>
				<svg class="mt-1 h-1.5 w-full" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
					<rect width="100" height="4" class="fill-panel-2"></rect>
					<rect width={ sessionPct(v.State) } height="4" class="fill-st-active"></rect>
				</svg>
			</div>
			<div class="flex items-center justify-between gap-3 text-xs">
				<span class="text-muted">Active devices <span class="num text-fg">{ itoa(v.State.ActiveDevices) } / { itoa(v.State.Devices) }</span></span>
				<span class="text-muted">Generation <span class="num text-fg">{ i64(int64(v.State.Generation)) }</span></span>
			</div>
			if len(v.Drift) > 0 {
				<div class="flex items-center justify-between gap-2 rounded-md border border-st-auth px-2 py-1.5 text-xs">
					<span><span class="font-semibold text-st-auth">Drift</span> env file differs: { joinComma(v.Drift) }</span>
					@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-post": "/fleet/instances/" + v.Name + "/reapply", "hx-target": "#flash", "hx-confirm": "Apply " + v.EnvPath + " to " + v.Name + "?"}) {
						Re-apply
					}
				</div>
			}
		} else {
			<p class="text-xs text-muted">{ v.Detail }</p>
			if v.Unit != "" {
				<p class="text-xs">Unit <span class="num">rcfg-sim@{ v.Name }</span>: <span class="num font-semibold">{ v.Unit }</span></p>
			}
		}
		<div class="flex items-end justify-between gap-3">
			<div class="min-w-0">
				<p class="text-xs text-muted">Sent</p>
				<p class="num">{ lastRate(v.BytesPS) }</p>
			</div>
			<svg class="h-7 w-32" viewBox="0 0 120 28" aria-label={ "bytes per second, last " + itoa(len(v.BytesPS)) + " polls" } role="img">
				<polyline points={ sparkPoints(v.BytesPS) } fill="none" class="stroke-accent-500" stroke-width="1.5" vector-effect="non-scaling-stroke"></polyline>
			</svg>
		</div>
		<div class="flex gap-2 border-t border-line pt-3">
			if v.Status == fleet.StatusUnused {
				@ui.DisabledButton(ui.Secondary, ui.Small, "The live build has no devices on this instance; rcfg-sim would not start. A testbench that needs it starts it.") {
					Start
				}
			} else {
				@unitButton(v.Name, "start", "Start", "")
				@unitButton(v.Name, "restart", "Restart", "Restart "+v.Name+"? Its sessions end.")
			}
			@unitButton(v.Name, "stop", "Stop", "Stop "+v.Name+"? Its devices go offline.")
		</div>
	}
}

templ unitButton(name, verb, label, confirm string) {
	if verb == "stop" {
		@ui.ConfirmButton(confirm, ui.Small, templ.Attributes{"hx-post": "/fleet/instances/" + name + "/" + verb, "hx-target": "#flash"}) {
			{ label }
		}
	} else if confirm != "" {
		@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-post": "/fleet/instances/" + name + "/" + verb, "hx-target": "#flash", "hx-confirm": confirm}) {
			{ label }
		}
	} else {
		@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-post": "/fleet/instances/" + name + "/" + verb, "hx-target": "#flash"}) {
			{ label }
		}
	}
}

templ rollingStatus(r RollingView) {
	if r.Running || r.Done {
		@ui.Toast(rollingKind(r), rollingTitle(r), append(r.Steps, errLine(r.Err)...))
	}
}

// panel is a titled card (kept as a short name for the screens).
templ panel(title, help string) {
	@ui.Card(title, help) {
		{ children... }
	}
}

// pendingWatch posts its form to url whenever an input changes, so the
// pending bar shows what Apply would do.
templ pendingWatch(url, form string) {
	<div hidden hx-post={ url } hx-trigger={ "input changed delay:250ms from:#" + form } hx-include={ "#" + form } hx-target="#pending" hx-swap="innerHTML"></div>
}

templ activeForm(m FleetModel) {
	@panel("Active devices", "Devices past the count drop connections, like the refuse profile. The fleet total is split across instances in proportion to their device counts.") {
		<form id="form-active" hx-post="/fleet/active" hx-target="#flash" class="flex flex-col gap-3">
			@pendingWatch("/pending/active", "form-active")
			@ui.Slider("active-total", "active", "of "+itoa(m.Devices), "0", itoa(m.Devices), "1", itoa(m.Active), nil, nil)
			@ui.Actions("Applies to new sessions on every instance and is saved to their env files.") {
				@ui.Submit(ui.Secondary, nil) {
					Apply active devices
				}
			}
		</form>
	}
}

templ delayForm(m FleetModel) {
	@panel("Response delay", "Uniform per-command delay window, in milliseconds. A latency profile replaces it on its devices.") {
		<form id="form-delay" hx-post="/fleet/delay" hx-target="#flash" class="flex flex-col gap-3">
			@pendingWatch("/pending/delay", "form-delay")
			if m.Ref != nil {
				@delayRow("Min", "delay-min", "delay_min", m.Ref.DelayMS.Min)
				@delayRow("Max", "delay-max", "delay_max", m.Ref.DelayMS.Max)
				@ui.Actions("Applies to new sessions on every instance and is saved to their env files.") {
					@ui.Submit(ui.Secondary, nil) {
						Apply delay
					}
				}
			} else {
				<p class="text-muted">No instance is up.</p>
			}
		</form>
	}
}

templ delayRow(label, id, name string, v int64) {
	@ui.Field(label, "") {
		@ui.Slider(id, name, "ms", "0", "5000", "1", i64(v), templ.Attributes{"max": "3600000"}, nil)
	}
}

templ capsForm(m FleetModel) {
	@panel("Session cap", "Concurrent sessions each instance admits. Lowering it ends no session; new ones are refused until the count drops.") {
		<form id="form-caps" hx-post="/fleet/caps" hx-target="#flash" class="flex flex-col gap-2">
			@pendingWatch("/pending/caps", "form-caps")
			for _, v := range upViews(m.Views) {
				<div class="grid grid-cols-[9rem_auto] items-center gap-3">
					<label for={ "cap-" + v.Name } class="num">{ v.Name }</label>
					@ui.NumberInput(templ.Attributes{"id": "cap-" + v.Name, "name": "cap_" + v.Name, "min": "1", "step": "1", "value": i64(v.State.MaxSessions), "class": "w-32"})
				</div>
			}
			@ui.Actions("Fleet total "+i64(m.CapTotal)+" sessions. New sessions beyond an instance's cap are refused; none are ended.") {
				@ui.Submit(ui.Secondary, nil) {
					Apply session caps
				}
			}
		</form>
	}
}

templ fleetActions() {
	@panel("Fleet actions", "Start, stop or restart every instance. A rolling restart does one at a time and waits for each to answer /healthz before the next.") {
		<form id="form-rolling" class="flex flex-col gap-3">
			<div class="flex flex-wrap items-center gap-2">
				@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": "/fleet/all/start", "hx-target": "#flash"}) {
					Start all
				}
				@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": "/fleet/all/restart", "hx-target": "#flash", "hx-confirm": "Restart every instance at once? All sessions end."}) {
					Restart all
				}
				@ui.ConfirmButton("Stop every instance? The whole fleet goes offline.", "", templ.Attributes{"hx-post": "/fleet/all/stop", "hx-target": "#flash"}) {
					Stop all
				}
			</div>
			@ui.Field("Pause between instances (s)", "A rolling restart waits for each instance to answer /healthz, then pauses this long before the next.") {
				@ui.NumberInput(templ.Attributes{"id": "rolling-pause", "name": "pause", "min": "0", "max": "600", "value": "5", "class": "w-24"})
			}
			@ui.Actions("Restarts the instances one at a time; each one's sessions end as it restarts.") {
				@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": "/fleet/rolling-restart", "hx-include": "#form-rolling", "hx-target": "#flash", "hx-confirm": "Restart the instances one at a time?"}) {
					Rolling restart
				}
			}
		</form>
	}
}
