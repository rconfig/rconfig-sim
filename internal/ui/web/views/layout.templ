package views

import ui "github.com/rcfg-sim/rcfg-sim/internal/ui/web/views/components"

// Layout is the shell of every page: header with the logo, the active
// testbench pill, device search, fleet health, the theme toggle and log
// out (section 10); the left rail; the pending-changes bar and flash area.
//
// The header is one row at every width: below xl the pills, the theme
// toggle and Log out collapse to icons and the search shrinks, so nothing
// is pushed off-screen or wraps under it. Below md the rail becomes a strip
// under the header that scrolls sideways on its own; the page never does.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0}'/>
			<title>{ p.Title } · Sim by rConfig</title>
			<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml"/>
			for _, css := range p.Styles {
				<link rel="stylesheet" href={ css }/>
			}
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/theme.js"></script>
			<script src="/static/vendor/htmx-2.0.11.min.js" defer></script>
			<script src="/static/app.js" defer></script>
			for _, js := range p.Scripts {
				<script src={ js } defer></script>
			}
		</head>
		<body class="min-h-screen text-sm">
			<header class="brand-hairline sticky top-0 z-20 border-b border-line bg-panel">
				<div class="flex h-14 min-w-0 items-center gap-2 px-3 sm:gap-4 sm:px-4">
					<a href="/" class="flex shrink-0 items-center" aria-label="Sim by rConfig: fleet">
						<img class="logo-dark h-8 w-8 object-cover object-left sm:w-auto" src="/static/img/sim-logo-white.svg" alt="Sim by rConfig"/>
						<img class="logo-light h-8 w-8 object-cover object-left sm:w-auto" src="/static/img/sim-logo-gradient.svg" alt="Sim by rConfig"/>
					</a>
					if p.Bench.State != "" {
						@BenchPillView(p.Bench)
					}
					<div class="ml-auto flex min-w-0 shrink-0 items-center gap-2 xl:gap-3">
						if p.User != "" {
							<form method="get" action="/devices/find" role="search" class="w-24 min-w-12 shrink sm:w-36 xl:w-44">
								@ui.Input(templ.Attributes{"name": "q", "placeholder": "Find a hostname", "aria-label": "Find a device by hostname", "class": "num w-full text-xs"})
							</form>
						}
						@HealthPill(p.Up, p.Total, false)
						<div class="segmented hidden shrink-0 flex-nowrap xl:inline-flex" role="group" aria-label="Theme">
							for _, t := range []string{"dark", "light", "auto"} {
								@ui.Button(ui.Ghost, ui.Small, templ.Attributes{"data-theme-set": t, "aria-pressed": "false"}) {
									<span class="capitalize">{ t }</span>
								}
							}
						</div>
						@ui.Button(ui.Ghost, ui.Small, templ.Attributes{"data-theme-cycle": "", "class": "shrink-0 xl:hidden", "title": "Theme: dark, light or auto"}) {
							<span data-theme-glyph aria-hidden="true">☾</span>
							<span class="sr-only" data-theme-name>Theme: dark. Change theme</span>
						}
						if p.User != "" {
							<span class="hidden text-xs text-muted xl:inline">{ p.User }</span>
							@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-post": "/logout", "class": "shrink-0", "title": "Log out " + p.User}) {
								@ui.Collapse("⇥", "Log out", false)
							}
						}
					</div>
				</div>
			</header>
			<div class="flex flex-col md:flex-row">
				<nav class="overflow-x-auto [scrollbar-width:thin] border-b border-line p-2 md:sticky md:top-14 md:h-[calc(100vh-3.5rem)] md:w-44 md:shrink-0 md:overflow-visible md:border-r md:border-b-0 md:p-3" aria-label="Main">
					<ul class="flex gap-1 md:flex-col">
						@navItem("/fleet", "Fleet", p.Nav == "fleet", true)
						@navItem("/testbenches", "Testbenches", p.Nav == "testbenches", true)
						@navItem("/runs", "Runs", p.Nav == "runs", true)
						@navItem("/devices", "Devices", p.Nav == "devices", true)
						@navItem("/failures", "Failures", p.Nav == "failures", true)
						@navItem("/activity", "Activity", p.Nav == "activity", true)
						@navItem("/build", "Build", p.Nav == "build", true)
						@navItem("/scenarios", "Scenarios", p.Nav == "scenarios", true)
					</ul>
				</nav>
				<main class="min-w-0 flex-1 p-4 sm:p-6">
					<div id="pending" class="sticky top-16 z-10" aria-live="polite"></div>
					<div id="flash" aria-live="polite"></div>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ navItem(href, label string, current, enabled bool) {
	<li>
		if enabled {
			<a
				href={ templ.SafeURL(href) }
				if current {
					aria-current="page"
				}
				class={ "block whitespace-nowrap rounded-md px-3 py-2 no-underline", templ.KV("bg-tint text-fg", current), templ.KV("text-muted hover:text-fg", !current) }
			>{ label }</a>
		} else {
			<span class="block cursor-not-allowed whitespace-nowrap px-3 py-2 text-muted opacity-50" title="Not in this release">{ label }</span>
		}
	</li>
}

// HealthPill shows instances up out of total. oob swaps it in from a
// polled fragment.
templ HealthPill(up, total int, oob bool) {
	<span
		id="health"
		if oob {
			hx-swap-oob="true"
		}
		class={ "num shrink-0 whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs", templ.KV("border-st-ok text-st-ok", total > 0 && up == total), templ.KV("border-st-auth text-st-auth", up < total) }
		title={ itoa(up) + " of " + itoa(total) + " instances up" }
	>
		{ itoa(up) } / { itoa(total) }<span class="collapse-text">{ " instances up" }</span>
	</span>
}

// Flashes renders action results into #flash.
templ Flashes(fs []Flash) {
	for _, f := range fs {
		@ui.Toast(f.Kind, f.Text, f.Lines)
	}
}

// PendingBar is the pending-changes bar. Empty when nothing would change.
templ PendingBar(d Diff) {
	if len(d.Items) > 0 {
		<div class="brand-fill pending-bar">
			<div class="min-w-0 flex-1">
				<p class="font-semibold">Pending changes, not applied</p>
				<ul class="mt-1 flex flex-col gap-0.5">
					for _, it := range d.Items {
						<li><span class="font-medium">{ it.What }:</span> <span class="num">{ it.From }</span> → <span class="num font-semibold">{ it.To }</span></li>
					}
				</ul>
				if d.Note != "" {
					<p class="mt-1 text-xs">{ d.Note }</p>
				}
			</div>
			@ui.Button(ui.Contrast, "", templ.Attributes{"hx-post": d.ApplyURL, "hx-include": "#" + d.Form, "hx-target": "#flash"}) {
				Apply
			}
		</div>
	}
}

// ClearPending empties the pending bar out of band, after an apply.
templ ClearPending() {
	<div id="pending" hx-swap-oob="innerHTML"></div>
}

// LoginPage is the login form (section 8): the logo and one card with two
// fields. htmx posts it; on success the server answers HX-Redirect.
templ LoginPage() {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"historyCacheSize":0}'/>
			<title>Log in · Sim by rConfig</title>
			<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/theme.js"></script>
			<script src="/static/vendor/htmx-2.0.11.min.js" defer></script>
		</head>
		<body class="grid min-h-screen place-items-center p-6 text-sm">
			<main class="w-full max-w-sm">
				<div class="mb-6 flex justify-center">
					<img class="logo-dark h-10 w-auto" src="/static/img/sim-logo-white.svg" alt="Sim by rConfig"/>
					<img class="logo-light h-10 w-auto" src="/static/img/sim-logo-gradient.svg" alt="Sim by rConfig"/>
				</div>
				<div class="brand-hairline">
					@ui.Card("Log in", "") {
						<form hx-post="/login" hx-target="#login-error" hx-swap="innerHTML" class="flex flex-col gap-4">
							@ui.Field("Username", "") {
								@ui.Input(templ.Attributes{"name": "username", "type": "text", "autocomplete": "username", "required": true, "autofocus": true})
							}
							@ui.Field("Password", "") {
								@ui.Input(templ.Attributes{"name": "password", "type": "password", "autocomplete": "current-password", "required": true})
							}
							<div id="login-error" aria-live="polite"></div>
							@ui.Submit(ui.Primary, nil) {
								Log in
							}
						</form>
					}
				</div>
			</main>
		</body>
	</html>
}

// LoginError is a failed login's message. It never says which value was
// wrong.
templ LoginError(msg string) {
	@ui.Toast(ui.ToastError, msg, nil)
}
