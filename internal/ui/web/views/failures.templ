package views

import (
	"net/url"

	"github.com/rcfg-sim/rcfg-sim/internal/ui/presets"
	ui "github.com/rcfg-sim/rcfg-sim/internal/ui/web/views/components"
)

// FailuresPage is the Failures screen (10.2). Nothing applies until Apply.
templ FailuresPage(p Page, m FailuresModel) {
	@Layout(p) {
		<div class="flex items-baseline justify-between gap-4">
			<h1 class="text-2xl">Failures</h1>
			<p class="text-muted">The same faults and profiles go to every instance. Changes apply to new sessions.</p>
		</div>
		<div class="mt-4">
			if m.NoneUp {
				@ui.Toast(ui.ToastWarn, "No instance is up, so nothing can be applied. The form shows defaults.", nil)
			} else if m.Mixed {
				@ui.Toast(ui.ToastWarn, "Instances differ in faults or profiles. The form shows the first instance; Apply makes them all match it.", nil)
			}
			if m.Loaded != "" {
				@ui.Toast(ui.ToastOK, "Preset "+m.Loaded+" loaded into the form. Review it, then Apply.", nil)
			}
		</div>
		<div class="mt-6 grid gap-6 2xl:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
			<form id="failures-form" hx-post="/failures/apply" hx-target="#flash" class="flex flex-col gap-6">
				@pendingWatch("/pending/failures", "failures-form")
				@faultsPanel(m)
				@profilesPanel(m)
				@ui.Advanced(0) {
					@ui.Field("Save these settings as a preset", "Saved presets can be loaded here or into a testbench, and applied in one click.") {
						<span class="flex flex-wrap items-center gap-2">
							@ui.Input(templ.Attributes{"id": "preset-name", "name": "preset_name", "type": "text", "maxlength": "64", "placeholder": "Name", "class": "w-48"})
							@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": "/presets/save", "hx-include": "#failures-form", "hx-target": "#flash"}) {
								Save preset
							}
						</span>
					}
				}
				@ui.Actions("Sends these faults and profiles to every instance that is up and saves them to the env files; down instances get them on their next start.") {
					@ui.Submit(ui.Primary, nil) {
						Apply to fleet
					}
				}
			</form>
			<div class="flex flex-col gap-6">
				@panel("Who is affected", "The devices these rules and this seed pick, the same ones rcfg-sim picks. Manifest-pinned devices are included.") {
					<div id="affected" hx-post="/failures/affected" hx-trigger="load, input changed delay:600ms from:#failures-form" hx-include="#failures-form" hx-swap="innerHTML">
						<p class="text-muted">Working out the affected devices…</p>
					</div>
				}
				@panel("Presets", "Load a preset into the form, or apply it to the fleet in one click.") {
					@PresetList(m.Presets)
				}
			</div>
		</div>
	}
}

templ faultsPanel(m FailuresModel) {
	@panel("Fault rates", "Probability per event, per type. Each event rolls independently.") {
		<div class="flex flex-col gap-4">
			for _, f := range m.Faults {
				<div class="flex flex-col gap-1">
					@ui.Field(f.Label, f.Help+". Flag name: "+f.Type+".") {
						@ui.Slider("pct-"+f.Type, "pct_"+f.Type, "%", "0", rangeMax(f.Pct), "0.1", pctStr(f.Pct),
							templ.Attributes{"max": "100", "step": "any"},
							templ.Attributes{"id": "range-" + f.Type, "data-default-max": "10"})
					}
					<p class="field-hint">
						About <span class="num text-fg" data-estimate={ "pct-" + f.Type } data-devices={ itoa(m.Devices) }>{ estimate(m.Devices, f.Pct) }</span> events per full poll of the fleet.
					</p>
				</div>
			}
			@ui.Checkbox("Allow sliders up to 100%", anyOver10(m.Faults), templ.Attributes{"data-extend": rangeIDs()})
		</div>
	}
}

templ profilesPanel(m FailuresModel) {
	@panel("Device profiles", "A fixed misbehaviour for a share of the fleet, chosen by hostname and seed, so the same devices misbehave every run.") {
		<div class="flex flex-col gap-3">
			<div class="hidden grid-cols-[9rem_minmax(0,1fr)_7rem_2rem] gap-3 text-xs text-muted sm:grid">
				<span>Profile</span><span>Parameters</span><span>Share</span><span></span>
			</div>
			<div id="rules" class="flex flex-col gap-2">
				for _, r := range m.Rules {
					@RuleRowView(r)
				}
			</div>
			<div>
				@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-get": "/failures/rule-row", "hx-target": "#rules", "hx-swap": "beforeend"}) {
					Add rule
				}
			</div>
			<p class="text-xs text-muted">Parameters: <span class="num">hang</span> a duration (<span class="num">3600s</span>), <span class="num">latency</span> a range (<span class="num">200-800ms</span>), none for <span class="num">refuse</span> and <span class="num">disconnect</span>. Shares add up to at most 100%.</p>
			@ui.Field("Seed", "Picks which devices get each profile. The same seed picks the same devices every run (flag --profile-seed).") {
				@ui.NumberInput(templ.Attributes{"id": "seed", "name": "seed", "step": "1", "value": i64(m.Seed), "class": "w-32"})
			}
		</div>
	}
}

// RuleRowView is one row of the profile rule editor.
templ RuleRowView(r RuleRow) {
	<div data-row class="grid items-center gap-3 sm:grid-cols-[9rem_minmax(0,1fr)_7rem_2rem]">
		@ui.Select("rule_kind", r.Kind, ruleKindOptions(), templ.Attributes{"aria-label": "Profile"})
		@ui.Input(templ.Attributes{"name": "rule_param", "type": "text", "value": r.Param, "placeholder": "3600s or 200-800ms", "aria-label": "Parameters", "class": "num"})
		<div class="flex items-center gap-1">
			@ui.NumberInput(templ.Attributes{"name": "rule_pct", "min": "0", "max": "100", "step": "any", "value": r.Pct, "aria-label": "Share of the fleet, percent", "class": "w-20"})
			<span class="text-muted">%</span>
		</div>
		@ui.Button(ui.Ghost, ui.Small, templ.Attributes{"data-remove-row": true, "aria-label": "Remove rule"}) {
			×
		}
	</div>
}

// AffectedList is the "who is affected" panel body.
templ AffectedList(m AffectedModel) {
	if m.Err != "" {
		<p class="text-st-error">{ m.Err }</p>
	}
	<p>
		<span class="num font-semibold">{ itoa(len(m.Items)) }</span> devices affected
		for _, c := range m.ByProfile {
			@ui.Pill("neutral", templ.Attributes{"class": "ml-2"}) {
				{ c.Profile } × { itoa(c.N) }
			}
		}
	</p>
	if len(m.Items) > 0 {
		<div class="mt-3 flex items-center gap-2">
			@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"data-copy": "affected-list"}) {
				Copy hostnames
			}
			if m.Shown < len(m.Items) {
				<span class="text-xs text-muted">Copies the first { itoa(m.Shown) }.</span>
			}
		</div>
		@ui.Code(templ.Attributes{"id": "affected-list", "class": "mt-2 max-h-80"}) {
			for _, a := range m.Items[:m.Shown] {
				{ a.Host + "\n" }
			}
		}
		<details class="mt-2 text-xs text-muted">
			<summary class="cursor-pointer">With addresses and profiles</summary>
			<table class="num mt-2 w-full">
				for _, a := range m.Items[:m.Shown] {
					<tr><td class="pr-3">{ a.Host }</td><td class="pr-3">{ a.IP }:{ itoa(a.Port) }</td><td>{ a.Profile }<span class="text-accent-500">{ pinnedMark(a.Pinned) }</span></td></tr>
				}
			</table>
		</details>
	}
}

func pinnedMark(p bool) string {
	if p {
		return " (pinned)"
	}
	return ""
}

// PresetList lists the presets. It refreshes itself after a save or delete.
templ PresetList(ps []presets.Preset) {
	<ul id="presets" hx-get="/failures/presets" hx-trigger="presets-changed from:body" hx-swap="outerHTML" class="flex flex-col divide-y divide-line">
		for _, p := range ps {
			<li class="flex flex-wrap items-center gap-2 py-2">
				<span class="font-medium">{ p.Name }</span>
				if p.BuiltIn {
					@ui.Badge(ui.BadgeMuted, "built-in, read-only")
				}
				<span class="ml-auto flex gap-2">
					@ui.LinkButton(ui.Secondary, ui.Small, "/failures?preset="+url.QueryEscape(p.Name), nil) {
						Load
					}
					@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"hx-post": "/presets/apply", "hx-vals": presetVals(p.Name), "hx-target": "#flash", "hx-confirm": "Apply preset " + p.Name + " to every instance now?"}) {
						Apply
					}
					if !p.BuiltIn {
						@ui.ConfirmButton("Delete preset "+p.Name+"?", ui.Small, templ.Attributes{"hx-post": "/presets/delete", "hx-vals": presetVals(p.Name), "hx-target": "#flash"}) {
							Delete
						}
					}
				</span>
			</li>
		}
	</ul>
}
