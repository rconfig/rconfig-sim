package views

import (
	"net/url"

	"github.com/rcfg-sim/rcfg-sim/internal/ui/presets"
)

// FailuresPage is the Failures screen (10.2). Nothing applies until Apply.
templ FailuresPage(p Page, m FailuresModel) {
	@Layout(p) {
		<div class="flex items-baseline justify-between gap-4">
			<h1 class="text-2xl">Failures</h1>
			<p class="text-muted">The same faults and profiles go to every instance. Changes apply to new sessions.</p>
		</div>
		if m.NoneUp {
			<p class="mt-4 rounded-card border border-st-auth bg-panel px-4 py-3">No instance is up, so nothing can be applied. The form shows defaults.</p>
		} else if m.Mixed {
			<p class="mt-4 rounded-card border border-st-auth bg-panel px-4 py-3">Instances differ in faults or profiles. The form shows the first instance; Apply makes them all match it.</p>
		}
		if m.Loaded != "" {
			<p class="mt-4 rounded-card border border-line bg-tint px-4 py-3">Preset <span class="font-semibold">{ m.Loaded }</span> loaded into the form. Review it, then Apply.</p>
		}
		<div class="mt-6 grid gap-6 2xl:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
			<form id="failures-form" hx-post="/failures/apply" hx-target="#flash" class="flex flex-col gap-6">
				@pendingWatch("/pending/failures", "failures-form")
				@faultsPanel(m)
				@profilesPanel(m)
				<div class="flex flex-wrap items-center gap-3">
					<button type="submit" class="rounded-md bg-accent-600 px-4 py-2 font-medium text-white hover:bg-accent-700">Apply to fleet</button>
					<span class="mx-1 h-6 border-l border-line"></span>
					<label for="preset-name" class="text-muted">Save as preset</label>
					<input id="preset-name" name="preset_name" type="text" maxlength="64" placeholder="Name" class="w-48 rounded-md border border-line bg-bg px-2 py-1"/>
					<button type="button" hx-post="/presets/save" hx-include="#failures-form" hx-target="#flash" class="rounded-md border border-line px-3 py-1.5 hover:bg-tint">Save</button>
				</div>
			</form>
			<div class="flex flex-col gap-6">
				@panel("Who is affected", "The devices these rules and this seed pick, the same ones rcfg-sim picks. Manifest-pinned devices are included.") {
					<div id="affected" hx-post="/failures/affected" hx-trigger="load, input changed delay:600ms from:#failures-form" hx-include="#failures-form" hx-swap="innerHTML">
						<p class="text-muted">Working out the affected devices…</p>
					</div>
				}
				@panel("Presets", "Load a preset into the form, or apply it to the fleet in one click.") {
					@PresetList(m.Presets)
				}
			</div>
		</div>
	}
}

templ faultsPanel(m FailuresModel) {
	@panel("Fault rates", "Probability per event, per type. Each event rolls independently.") {
		<div class="flex flex-col gap-4">
			for _, f := range m.Faults {
				<div class="grid items-center gap-x-3 gap-y-1 sm:grid-cols-[12rem_minmax(0,1fr)_7rem]">
					<div>
						<label for={ "pct-" + f.Type } class="font-medium">{ f.Label }</label>
						<p class="num text-xs text-muted">{ f.Type }</p>
					</div>
					<input type="range" id={ "range-" + f.Type } min="0" max={ rangeMax(f.Pct) } data-default-max="10" step="0.1" value={ pctStr(f.Pct) } data-sync={ "pct-" + f.Type } aria-label={ f.Label + " percent" }/>
					<div class="flex items-center gap-1">
						<input id={ "pct-" + f.Type } name={ "pct_" + f.Type } type="number" min="0" max="100" step="any" value={ pctStr(f.Pct) } class="num w-20 rounded-md border border-line bg-bg px-2 py-1"/>
						<span class="text-muted">%</span>
					</div>
					<p class="text-xs text-muted sm:col-start-2 sm:col-span-2">
						{ f.Help }. About <span class="num text-fg" data-estimate={ "pct-" + f.Type } data-devices={ itoa(m.Devices) }>{ estimate(m.Devices, f.Pct) }</span> events per full poll of the fleet.
					</p>
				</div>
			}
			<label class="flex items-center gap-2 text-muted">
				<input type="checkbox" data-extend={ rangeIDs() } checked?={ anyOver10(m.Faults) }/>
				Allow sliders up to 100%
			</label>
		</div>
	}
}

templ profilesPanel(m FailuresModel) {
	@panel("Device profiles", "A fixed misbehaviour for a share of the fleet, chosen by hostname and seed, so the same devices misbehave every run.") {
		<div class="flex flex-col gap-3">
			<div class="hidden grid-cols-[9rem_minmax(0,1fr)_7rem_2rem] gap-3 text-xs text-muted sm:grid">
				<span>Profile</span><span>Parameters</span><span>Share</span><span></span>
			</div>
			<div id="rules" class="flex flex-col gap-2">
				for _, r := range m.Rules {
					@RuleRowView(r)
				}
			</div>
			<div>
				<button type="button" hx-get="/failures/rule-row" hx-target="#rules" hx-swap="beforeend" class="rounded-md border border-line px-3 py-1.5 hover:bg-tint">Add rule</button>
			</div>
			<p class="text-xs text-muted">Parameters: <span class="num">hang</span> a duration (<span class="num">3600s</span>), <span class="num">latency</span> a range (<span class="num">200-800ms</span>), none for <span class="num">refuse</span> and <span class="num">disconnect</span>. Shares add up to at most 100%.</p>
			<div class="flex items-center gap-3">
				<label for="seed" class="text-muted">Seed</label>
				<input id="seed" name="seed" type="number" step="1" value={ i64(m.Seed) } class="num w-32 rounded-md border border-line bg-bg px-2 py-1"/>
			</div>
		</div>
	}
}

// RuleRowView is one row of the profile rule editor.
templ RuleRowView(r RuleRow) {
	<div data-row class="grid items-center gap-3 sm:grid-cols-[9rem_minmax(0,1fr)_7rem_2rem]">
		<select name="rule_kind" aria-label="Profile" class="rounded-md border border-line bg-bg px-2 py-1">
			for _, k := range RuleKinds {
				<option value={ k } selected?={ k == r.Kind }>{ k }</option>
			}
		</select>
		<input name="rule_param" type="text" value={ r.Param } placeholder="3600s or 200-800ms" aria-label="Parameters" class="num rounded-md border border-line bg-bg px-2 py-1"/>
		<div class="flex items-center gap-1">
			<input name="rule_pct" type="number" min="0" max="100" step="any" value={ r.Pct } aria-label="Share of the fleet, percent" class="num w-20 rounded-md border border-line bg-bg px-2 py-1"/>
			<span class="text-muted">%</span>
		</div>
		<button type="button" data-remove-row aria-label="Remove rule" class="rounded-md border border-line px-2 py-1 hover:bg-tint">×</button>
	</div>
}

// AffectedList is the "who is affected" panel body.
templ AffectedList(m AffectedModel) {
	if m.Err != "" {
		<p class="text-st-error">{ m.Err }</p>
	}
	<p>
		<span class="num font-semibold">{ itoa(len(m.Items)) }</span> devices affected
		for _, c := range m.ByProfile {
			<span class="ml-2 rounded-full border border-line px-2 py-0.5 text-xs"><span class="num">{ c.Profile }</span> × <span class="num">{ itoa(c.N) }</span></span>
		}
	</p>
	if len(m.Items) > 0 {
		<div class="mt-3 flex items-center gap-2">
			<button type="button" data-copy="affected-list" class="rounded-md border border-line px-3 py-1 text-xs hover:bg-tint">Copy hostnames</button>
			if m.Shown < len(m.Items) {
				<span class="text-xs text-muted">Copies the first { itoa(m.Shown) }.</span>
			}
		</div>
		<pre id="affected-list" class="num mt-2 max-h-80 overflow-auto rounded-md border border-line bg-bg p-3 text-xs">
			for _, a := range m.Items[:m.Shown] {
				{ a.Host + "\n" }
			}
		</pre>
		<details class="mt-2 text-xs text-muted">
			<summary class="cursor-pointer">With addresses and profiles</summary>
			<table class="num mt-2 w-full">
				for _, a := range m.Items[:m.Shown] {
					<tr><td class="pr-3">{ a.Host }</td><td class="pr-3">{ a.IP }:{ itoa(a.Port) }</td><td>{ a.Profile }<span class="text-accent-500">{ pinnedMark(a.Pinned) }</span></td></tr>
				}
			</table>
		</details>
	}
}

func pinnedMark(p bool) string {
	if p {
		return " (pinned)"
	}
	return ""
}

// PresetList lists the presets. It refreshes itself after a save or delete.
templ PresetList(ps []presets.Preset) {
	<ul id="presets" hx-get="/failures/presets" hx-trigger="presets-changed from:body" hx-swap="outerHTML" class="flex flex-col divide-y divide-line">
		for _, p := range ps {
			<li class="flex flex-wrap items-center gap-2 py-2">
				<span class="font-medium">{ p.Name }</span>
				if p.BuiltIn {
					<span class="rounded-full border border-line px-2 text-xs text-muted">built-in</span>
				}
				<span class="ml-auto flex gap-2">
					<a href={ templ.SafeURL("/failures?preset=" + url.QueryEscape(p.Name)) } class="rounded-md border border-line px-2.5 py-1 text-xs no-underline hover:bg-tint">Load</a>
					<button type="button" hx-post="/presets/apply" hx-vals={ templ.JSONString(map[string]string{"name": p.Name}) } hx-target="#flash" hx-confirm={ "Apply preset " + p.Name + " to every instance now?" } class="rounded-md bg-accent-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-accent-700">Apply</button>
					if !p.BuiltIn {
						<button type="button" hx-post="/presets/delete" hx-vals={ templ.JSONString(map[string]string{"name": p.Name}) } hx-target="#flash" hx-confirm={ "Delete preset " + p.Name + "?" } class="rounded-md border border-line px-2.5 py-1 text-xs hover:bg-tint">Delete</button>
					}
				</span>
			</li>
		}
	</ul>
}
