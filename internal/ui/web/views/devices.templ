package views

import ui "github.com/rcfg-sim/rcfg-sim/internal/ui/web/views/components"

// DevicesPage is the Devices screen (10.7).
templ DevicesPage(p Page, m DevicesModel, sorts []SortLink, exportCSV, exportJSON string) {
	@Layout(p) {
		<div class="flex flex-wrap items-baseline justify-between gap-4">
			<h1 class="text-2xl">Devices <span class="num text-sm text-muted">{ m.Scope }</span></h1>
			if m.Missing == "" {
				<div class="flex flex-wrap items-center gap-2">
					@ui.LinkButton(ui.Secondary, "", exportCSV, templ.Attributes{"download": true}) {
						Export CSV
					}
					@ui.LinkButton(ui.Secondary, "", exportJSON, templ.Attributes{"download": true}) {
						Export JSON
					}
				</div>
			}
		</div>
		if m.Missing != "" {
			<div class="mt-6">
				@ui.Empty("No devices to list", m.Missing) {
					if m.BuildSlug != "" {
						@ui.Button(ui.Primary, "", templ.Attributes{"hx-post": "/testbenches/" + m.BuildSlug + "/keep-build", "hx-target": "#keep-build-job", "hx-confirm": "Generate this testbench's build now? It is kept on disk but not made live; nothing restarts."}) {
							Build it
						}
					}
				}
				<div id="keep-build-job" class="mt-4"></div>
			</div>
		} else {
			if m.NotLive {
				<div class="mt-4">
					@ui.Toast(ui.ToastWarn, "This build is kept but not live: the instances are serving another build, so every device here is inactive until a testbench using it starts.", nil)
				</div>
			}
			@deviceSummary(m)
			@deviceFilters(m)
			<p class="mt-4 text-xs text-muted">
				{ itoa(m.Matched) } of { itoa(m.Summary.Total) } devices match.
				@ui.Help("Exports contain exactly these rows, with the columns hostname, ip, port, username, password, enable_password, model, status, status_reason.")
			</p>
			<div class="mt-2">
				@ui.Table(nil) {
					<thead>
						<tr>
							for _, s := range sorts {
								<th>
									if s.Href == "" {
										{ s.Label }
									} else {
										<a href={ templ.SafeURL(s.Href) } class={ "no-underline", templ.KV("text-fg", s.Active) }>
											{ s.Label }
											if s.Active && s.Desc {
												↓
											} else if s.Active {
												↑
											}
										</a>
									}
								</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, r := range m.Rows {
							<tr>
								<td class="num"><a href={ templ.SafeURL(r.Href) } hx-get={ r.Href } hx-target="#device-drawer" hx-push-url="false">{ r.Hostname }</a></td>
								<td>
									if r.Family != "" {
										@ui.Badge(ui.BadgeFamily, r.Family)
									}
								</td>
								<td class="num">{ r.IP }</td>
								<td class="num">{ itoa(r.Port) }</td>
								<td class="num">{ r.Model }</td>
								<td class="num">
									{ r.Username }
									<details class="inline"><summary class="cursor-pointer text-muted">password</summary><span class="num">{ r.Password }</span></details>
								</td>
								<td class="num">{ orDash(r.Profile) }</td>
								<td class={ statusClass2(r.Status) }>
									{ r.Status }
									if r.Reason != "" {
										<span class="text-muted">· { r.Reason }</span>
									}
								</td>
								<td class="num">{ orDash(r.LastOutcome) }</td>
								<td class="num">{ orDash(r.LastSeen) }</td>
							</tr>
						}
						if len(m.Rows) == 0 {
							<tr><td colspan="10" class="py-6 text-center text-muted">No devices match these filters. <a href={ templ.SafeURL("/devices" + scopeSuffix(m.ScopeQuery)) }>Clear the filters</a>.</td></tr>
						}
					</tbody>
				}
			</div>
			if m.Pages > 1 {
				<nav class="mt-3 flex flex-wrap items-center gap-3 text-xs" aria-label="Pages">
					if m.Page > 1 {
						<a href={ templ.SafeURL(pageHref(m.Query, m.Page-1)) }>Previous</a>
					}
					<span class="num text-muted">page { itoa(m.Page) } of { itoa(m.Pages) }</span>
					if m.Page < m.Pages {
						<a href={ templ.SafeURL(pageHref(m.Query, m.Page+1)) }>Next</a>
					}
				</nav>
			}
		}
		<aside
			id="device-drawer"
			class="mt-6"
			aria-live="polite"
			data-drawer
			if m.Open != "" {
				hx-get={ "/device/" + m.Open + scopeSuffix(m.ScopeQuery) }
				hx-trigger="load"
			}
		></aside>
	}
}

templ deviceSummary(m DevicesModel) {
	<div class="mt-6 flex flex-wrap gap-2 text-xs">
		@countLink(KVCount{Label: "all", Count: m.Summary.Total, Href: "/devices" + scopeSuffix(m.ScopeQuery)})
		@countLink(KVCount{Label: "active", Count: m.Summary.Active, Href: "/devices?status=active" + scopeAmp(m.ScopeQuery)})
		for _, c := range m.Summary.Inactive {
			@countLink(c)
		}
		if m.Summary.Unknown > 0 {
			@countLink(KVCount{Label: "unknown", Count: m.Summary.Unknown, Href: "/devices?status=unknown" + scopeAmp(m.ScopeQuery)})
		}
		<span class="mx-2 border-l border-line"></span>
		for _, c := range m.Summary.Families {
			@countLink(c)
		}
		<span class="mx-2 border-l border-line"></span>
		for _, c := range m.Summary.Models {
			@countLink(c)
		}
	</div>
}

templ countLink(c KVCount) {
	@ui.PillLink("neutral", c.Href, nil) {
		{ c.Label } <span class="text-fg">{ itoa(c.Count) }</span>
	}
}

templ deviceFilters(m DevicesModel) {
	<form method="get" action="/devices" class="mt-4 flex flex-wrap items-end gap-3 text-xs">
		if m.ScopeQuery != "" {
			for _, kv := range scopeFields(m.ScopeQuery) {
				<input type="hidden" name={ kv.K } value={ kv.V }/>
			}
		}
		@ui.Field("Search", "") {
			@ui.Input(templ.Attributes{"name": "q", "value": m.Filters.Q, "placeholder": "hostname or IP", "class": "num"})
		}
		@selectFilter("status", "Status", m.Filters.Status, []string{"active", "inactive", "unknown"})
		@selectFilter("reason", "Reason", m.Filters.Reason, []string{"beyond active count", "instance down", "testbench stopped", "admin API off", "bad env file", "port clash", "admin API error", "no instance for this IP", "build not live"})
		@selectFilter("family", "Family", m.Filters.Family, m.Families)
		@selectFilter("instance", "Instance", m.Filters.Instance, m.Instances)
		@selectFilter("model", "Model", m.Filters.Model, m.Models)
		@selectFilter("profile", "Profile", m.Filters.Profile, []string{"none", "hang", "latency", "refuse", "disconnect"})
		@selectFilter("outcome", "Last outcome", m.Filters.Outcome, []string{"never", "ok", "auth_fail", "disconnect", "error", "hang", "inactive", "active"})
		@ui.Submit(ui.Secondary, nil) {
			Filter
		}
		<a href={ templ.SafeURL("/devices" + scopeSuffix(m.ScopeQuery)) } class="py-1.5 text-muted">Clear</a>
	</form>
}

templ selectFilter(name, label, cur string, opts []string) {
	@ui.Field(label, "") {
		@ui.Select(name, cur, anyOptions(opts), nil)
	}
}

// DeviceDrawer is one device's details, ssh command and Test login.
templ DeviceDrawer(m DeviceDrawerModel) {
	@ui.Panel(templ.Attributes{"aria-label": "Device"}) {
		if m.Err != "" {
			<p class="text-st-error">{ m.Err }</p>
		} else {
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<h2 class="num text-lg">
					{ m.Row.Hostname }
					if m.Row.Family != "" {
						@ui.Badge(ui.BadgeFamily, m.Row.Family)
					}
				</h2>
				<p class={ statusClass2(m.Row.Status) }>
					{ m.Row.Status }
					if m.Row.Reason != "" {
						<span class="text-muted">· { m.Row.Reason }</span>
					}
				</p>
			</div>
			<dl class="mt-3 grid grid-cols-[9rem_minmax(0,1fr)] gap-x-3 gap-y-1 text-xs">
				<dt class="text-muted">Address</dt><dd class="num">{ m.Row.IP }:{ itoa(m.Row.Port) }</dd>
				<dt class="text-muted">Instance</dt><dd class="num">{ orDash(m.Row.Instance) }</dd>
				<dt class="text-muted">Model</dt><dd class="num">{ m.Row.Model } ({ m.Template })</dd>
				<dt class="text-muted">Username</dt><dd class="num">{ m.Row.Username }</dd>
				<dt class="text-muted">Password</dt><dd><details><summary class="cursor-pointer text-muted">reveal</summary><span class="num">{ m.Row.Password }</span></details></dd>
				<dt class="text-muted">Enable password</dt><dd><details><summary class="cursor-pointer text-muted">reveal</summary><span class="num">{ m.EnablePassword }</span></details></dd>
				<dt class="text-muted">Profile</dt>
				<dd class="num">
					{ orDash(m.Row.Profile) }
					if m.ProfilePinned {
						(pinned in the manifest)
					}
				</dd>
				<dt class="text-muted">Last outcome</dt><dd class="num">{ orDash(m.Row.LastOutcome) }</dd>
				<dt class="text-muted">Last seen</dt><dd class="num">{ orDash(m.Row.LastSeen) }</dd>
			</dl>
			<div class="mt-4 flex flex-wrap items-center gap-2">
				<code id="device-ssh" class="num rounded-md border border-line bg-bg px-2 py-1 text-xs">{ m.SSH }</code>
				@ui.Button(ui.Secondary, ui.Small, templ.Attributes{"data-copy": "device-ssh"}) {
					Copy
				}
			</div>
			<div class="mt-4">
				if m.TestURL != "" {
					<div class="flex flex-wrap items-center gap-2">
						@ui.Button(ui.Secondary, "", templ.Attributes{"hx-post": m.TestURL, "hx-target": "#login-test"}) {
							Test login
						}
						@ui.Help("Logs in with the manifest credentials and runs " + m.TestCommand + ". It is a normal session, so faults apply.")
					</div>
				} else {
					<p class="text-xs text-muted">Test login needs the build to be live.</p>
				}
				<div id="login-test" class="mt-3" aria-live="polite"></div>
			</div>
			<div class="mt-4">
				<h3 class="text-sm text-muted">Recent events</h3>
				if len(m.Events) == 0 {
					<p class="text-xs text-muted">None seen (events are sampled while the Activity page is open).</p>
				} else {
					<ol class="num mt-1 flex flex-col gap-0.5 text-xs">
						for _, e := range m.Events {
							<li>{ e }</li>
						}
					</ol>
				}
			</div>
		}
	}
}

// LoginTestResult is a Test login outcome.
templ LoginTestResult(m LoginTestModel) {
	if m.OK {
		@ui.Toast(ui.ToastOK, "Logged in in "+m.LoginTime+"; "+m.Command+" answered, "+m.Total+" in all.", hintLines(m.Hint))
	} else {
		@ui.Toast(ui.ToastError, "Failed at "+m.Stage+": "+m.Err, hintLines(m.Hint))
	}
	if len(m.Output) > 0 {
		@ui.Code(templ.Attributes{"class": "mt-2 max-h-48"}) {
			for _, l := range m.Output {
				{ l + "\n" }
			}
		}
	}
}

// Checklist is the first-login checklist on the Fleet screen (Phase 7
// item 7). It refreshes itself so the ticks are live.
templ Checklist(m ChecklistModel) {
	<div id="checklist" hx-get="/checklist" hx-trigger="every 5s" hx-swap="outerHTML" class="mt-6">
		@ui.Panel(templ.Attributes{"aria-label": "Getting started"}) {
			if len(m.Items) > 0 && m.Done == len(m.Items) {
				<div class="flex flex-wrap items-center justify-between gap-3">
					<p class="flex items-center gap-2">
						<span class="text-st-ok" aria-hidden="true">✓</span>
						<span class="font-medium">All set</span>
						<span class="num text-xs text-muted">{ itoa(m.Done) } of { itoa(len(m.Items)) } done</span>
					</p>
					@checklistDismiss()
				</div>
			} else {
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 class="text-lg">Getting started <span class="num text-sm text-muted">{ itoa(m.Done) } of { itoa(len(m.Items)) }</span></h2>
					@checklistDismiss()
				</div>
				<ul class="mt-3 flex flex-col gap-1">
					for _, it := range m.Items {
						<li class="flex items-center gap-2">
							if it.Done {
								<span class="w-4 text-center text-st-ok" aria-hidden="true">✓</span>
								<a href={ templ.SafeURL(it.Href) } class="text-muted">{ it.Text }<span class="sr-only">{ " (done)" }</span></a>
							} else {
								<span class="w-4 text-center text-muted" aria-hidden="true">○</span>
								<a href={ templ.SafeURL(it.Href) }>{ it.Text }</a>
							}
						</li>
					}
				</ul>
			}
		}
	</div>
}

templ checklistDismiss() {
	@ui.Button(ui.Ghost, ui.Small, templ.Attributes{"hx-post": "/checklist/dismiss", "hx-target": "#checklist", "hx-swap": "outerHTML"}) {
		Dismiss
	}
}
