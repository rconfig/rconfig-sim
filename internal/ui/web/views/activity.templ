package views

// ActivityPage is the Activity screen (10.3). One server-sent event stream
// (/activity/stream, through htmx-ext-sse) carries everything: the summary
// strip is swapped in as HTML; activity.js reads the frame, rates, history,
// event and dropped messages from the same connection.
templ ActivityPage(p Page) {
	@Layout(p) {
		<div class="flex items-baseline justify-between gap-4">
			<h1 class="text-2xl">Activity</h1>
			<p class="text-muted">Live while this page is open. Nothing is stored beyond the 10-minute chart window.</p>
		</div>
		<div hx-ext="sse" sse-connect="/activity/stream" id="activity" class="mt-6 flex flex-col gap-6">
			<div sse-swap="summary" hx-swap="innerHTML" aria-live="off">
				@ActivitySummary(SummaryModel{})
			</div>
			<section class="rounded-card border border-line bg-panel p-5" aria-label="Device heatmap">
				<div class="flex items-baseline justify-between gap-3">
					<h2 class="text-lg">Devices</h2>
					<p class="num text-xs text-muted" id="heat-stats" aria-live="off"></p>
				</div>
				<p class="mt-1 text-muted">Every device as one cell, coloured by state. Hover for its name; click for details.</p>
				<div class="mt-4 grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
					<div id="heat-wrap" class="relative min-w-0">
						<canvas id="heatmap" class="block max-w-full cursor-crosshair [image-rendering:pixelated]" width="250" height="40" role="img" aria-label="Device state heatmap; the legend above gives the counts per state"></canvas>
						<div id="heat-tip" class="pointer-events-none absolute z-10 hidden rounded-md border border-line bg-panel px-2 py-1 text-xs shadow-sm" role="tooltip"></div>
					</div>
					<aside id="device-panel" class="rounded-card border border-line bg-bg p-4 text-muted" aria-live="polite">
						Click a device for its details and recent events.
					</aside>
				</div>
			</section>
			<section class="grid gap-6 xl:grid-cols-2" aria-label="Live charts">
				@chartPanel("chart-active", "Active sessions", "Sessions open now, across the fleet.")
				@chartPanel("chart-sessions", "Sessions per second, by outcome", "Sessions ending each second.")
				@chartPanel("chart-bytes", "Bytes per second", "Bytes sent to clients.")
				@chartPanel("chart-faults", "Faults per second, by type", "Faults injected each second.")
			</section>
			@eventTail()
		</div>
	}
}

templ chartPanel(id, title, help string) {
	<div class="rounded-card border border-line bg-panel p-5">
		<h2 class="text-lg">{ title }</h2>
		<p class="text-muted">{ help }</p>
		<div id={ id } class="mt-3 h-56 min-w-0" data-chart></div>
	</div>
}

templ eventTail() {
	<section class="rounded-card border border-line bg-panel p-5" aria-label="Event tail">
		<div class="flex flex-wrap items-center gap-3">
			<h2 class="mr-auto text-lg">Events</h2>
			<label class="sr-only" for="tail-host">Filter by hostname</label>
			<input id="tail-host" type="search" placeholder="Hostname" class="w-44 rounded-md border border-line bg-bg px-2 py-1"/>
			<label class="sr-only" for="tail-outcome">Filter by outcome</label>
			<select id="tail-outcome" class="rounded-md border border-line bg-bg px-2 py-1">
				<option value="">Any outcome</option>
				for _, o := range []string{"ok", "error", "auth_fail", "disconnect"} {
					<option value={ o }>{ o }</option>
				}
			</select>
			<label class="sr-only" for="tail-fault">Filter by fault</label>
			<select id="tail-fault" class="rounded-md border border-line bg-bg px-2 py-1">
				<option value="">Any fault</option>
				for _, f := range FaultTypes {
					<option value={ f.Type }>{ f.Type }</option>
				}
			</select>
			<button id="tail-pause" type="button" aria-pressed="false" class="rounded-md border border-line px-3 py-1 hover:bg-tint aria-pressed:bg-tint">Pause</button>
		</div>
		<p class="mt-1 text-xs text-muted"><span id="tail-status">Waiting for events…</span> <span id="tail-dropped" class="num"></span></p>
		<div class="mt-3 max-h-96 overflow-auto rounded-md border border-line">
			<table class="num w-full text-left text-xs">
				<thead class="sticky top-0 bg-panel text-muted">
					<tr><th class="px-2 py-1">Time</th><th class="px-2 py-1">Kind</th><th class="px-2 py-1">Host</th><th class="px-2 py-1">Port</th><th class="px-2 py-1">Outcome</th><th class="px-2 py-1">Fault</th><th class="px-2 py-1 text-right">Bytes</th><th class="px-2 py-1 text-right">ms</th></tr>
				</thead>
				<tbody id="tail-body"></tbody>
			</table>
		</div>
	</section>
}

// ActivitySummary is the strip above the heatmap: instances, the legend
// with a count per state, and drop counts. Pushed over SSE with every frame.
templ ActivitySummary(m SummaryModel) {
	<div class="flex flex-wrap items-center gap-x-5 gap-y-2 rounded-card border border-line bg-panel px-4 py-3">
		<span><span class="num font-semibold">{ itoa(m.Reachable) }</span> / <span class="num">{ itoa(m.Instances) }</span> instances reporting</span>
		<span><span class="num font-semibold">{ itoa(m.Devices) }</span> devices</span>
		<ul class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Legend">
			for _, l := range m.Legend {
				<li class="flex items-center gap-1.5">
					<span class={ "inline-block size-3 rounded-sm border border-line", l.Class } aria-hidden="true"></span>
					<span>{ l.Name }</span>
					<span class="num text-muted">{ itoa(l.N) }</span>
				</li>
			}
		</ul>
		if m.Upstream > 0 {
			<span class="ml-auto text-xs text-muted">Instances dropped <span class="num">{ i64(int64(m.Upstream)) }</span> events (200/s cap per instance)</span>
		}
	</div>
}

// DevicePanel is the heatmap side panel for one device.
templ DevicePanel(m DeviceModel) {
	<div class="flex flex-col gap-3 text-fg">
		if m.Err != "" {
			<p class="text-st-error">{ m.Err }</p>
		}
		<div>
			<h3 class="num text-base">
				if m.Host != "" {
					{ m.Host }
				} else {
					(no manifest row)
				}
			</h3>
			<p class="num text-xs text-muted">{ m.IP }:{ itoa(m.Port) } · instance { m.Instance }</p>
		</div>
		<dl class="grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1">
			<dt class="text-muted">State</dt>
			<dd class="flex items-center gap-1.5"><span class={ "inline-block size-3 rounded-sm border border-line", m.StateClass } aria-hidden="true"></span>{ m.State }</dd>
			<dt class="text-muted">Last seen</dt>
			<dd class="num">{ m.LastSeen }</dd>
			<dt class="text-muted">Profile</dt>
			<dd class="num">
				if m.Profile == "" {
					none
				} else {
					{ m.Profile }{ pinnedMark(m.Pinned) }
				}
			</dd>
		</dl>
		<div>
			<h4 class="text-sm text-muted">Recent events</h4>
			if len(m.Events) == 0 {
				<p class="text-xs text-muted">None since this page opened (events are sampled).</p>
			} else {
				<ol class="num mt-1 flex flex-col gap-0.5 text-xs">
					for _, e := range m.Events {
						<li>{ e }</li>
					}
				</ol>
			}
		</div>
	</div>
}
