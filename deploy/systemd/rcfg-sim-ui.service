[Unit]
Description=rConfig SSH simulator web UI (rcfg-sim-ui)
Documentation=file:///opt/rcfg-sim/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user, separate from the device processes (rcfgsim). The group may
# write /etc/rcfg-sim; see docs/UI-ARCHITECTURE.md 7.3 and `make install-ui`.
User=rcfgsim-ui
Group=rcfgsim-ui

# Defaults for every variable ExecStart uses, matching the rcfg-sim-ui flag
# defaults. Override them in the env file below.
Environment=UI_ADDR=127.0.0.1:8080
Environment=ENV_DIR=/etc/rcfg-sim
Environment=GEN_BIN=/opt/rcfg-sim/bin/rcfg-sim-gen
Environment=DATA_DIR=/var/lib/rcfg-sim-ui
Environment=POLL=2s
Environment=SYSTEMCTL=systemctl
Environment=LOG_LEVEL=info
Environment=UI_ALLOWED_HOSTS=
Environment=KEEP_BUILDS=3
Environment=KEEP_RUNS=200
Environment=START_TIMEOUT=120s
Environment=SCENARIOS_DIR=/var/lib/rcfg-sim-ui/scenarios

# UI_USERNAME and UI_PASSWORD_HASH (the login) reach rcfg-sim-ui only as
# environment variables from this file, never on the command line (visible
# in ps). rcfg-sim-ui refuses to start without them.
EnvironmentFile=-/etc/rcfg-sim-ui/rcfg-sim-ui.env

ExecStart=/opt/rcfg-sim/bin/rcfg-sim-ui \
    --ui-addr=${UI_ADDR} \
    --env-dir=${ENV_DIR} \
    --gen-bin=${GEN_BIN} \
    --data-dir=${DATA_DIR} \
    --poll=${POLL} \
    --systemctl=${SYSTEMCTL} \
    --log-level=${LOG_LEVEL} \
    --ui-allowed-hosts=${UI_ALLOWED_HOSTS} \
    --keep-builds=${KEEP_BUILDS} \
    --keep-runs=${KEEP_RUNS} \
    --start-timeout=${START_TIMEOUT} \
    --scenarios-dir=${SCENARIOS_DIR}

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rcfg-sim-ui

# Presets, testbenches, runs, job logs and your scenario packages
# (scenarios/). systemd creates /var/lib/rcfg-sim-ui for the user.
StateDirectory=rcfg-sim-ui
StateDirectoryMode=0750
# New env files and temp files stay group-writable for rcfgsim-ui only.
UMask=0007

# Sandboxing. Writes only its state directory, /etc/rcfg-sim and the build
# data directory (/opt/rcfg-sim/data, absent until `make adopt-data`, hence
# the "-"). Never the rest of /opt/rcfg-sim, so it cannot replace the
# simulator binaries. Unit control
# goes to systemd over D-Bus and is authorised by the polkit rule, so no
# privilege escalation is needed. Hosts using the sudoers alternative must
# set NoNewPrivileges=false in a drop-in (see the README).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/rcfg-sim -/opt/rcfg-sim/data
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
