# Sample rcfg-sim per-instance environment file.
# Copy to /etc/rcfg-sim/<LISTEN_IP>.env and customise.
#
# Example: cp rcfg-sim-instance.env.sample /etc/rcfg-sim/10.50.0.1.env
# The instance name in rcfg-sim@<INSTANCE>.service MUST equal LISTEN_IP
# — systemd uses %i to locate this file.
#
# Every value here maps 1:1 to an rcfg-sim flag. No escaping needed unless
# a value contains whitespace or shell metacharacters; in that case quote
# as "value".
#
# The unit sets a default for every variable (the rcfg-sim flag default), so
# a variable left out of this file takes that default.

# --- Network ---

# IP to bind listeners on. Must be a real interface alias on this host.
# See deploy/ip-aliases.sh for the batched setup helper.
LISTEN_IP=10.50.0.1

# Contiguous TCP port range bound by this instance. PORT_START .. PORT_START + PORT_COUNT - 1.
# Standard layout: 10000..12499 for devices 0..2499 under each IP.
PORT_START=10000
PORT_COUNT=2500

# --- Data ---

# Path to the manifest.csv produced by rcfg-sim-gen. This instance loads the
# rows whose `ip` matches LISTEN_IP and `port` is in this instance's range.
MANIFEST=/opt/rcfg-sim/manifest.csv

# SSH host key. Generated 2048-bit RSA on first run if absent; persisted
# across restarts. Must be writable by the rcfgsim user. Default location is
# /opt/rcfg-sim/host-keys/<LISTEN_IP>.key (per README); /etc/rcfg-sim is also
# in the unit's ReadWritePaths if operators prefer /etc conventions.
HOST_KEY=/opt/rcfg-sim/host-keys/10.50.0.1.key

# --- Credentials ---
# These must match the manifest row credentials so rConfig's polling succeeds.

USERNAME=admin
PASSWORD=admin
ENABLE_PASSWORD=enable123

# SSH transport auth: password (every device) | driver (per driver: Cisco IOS
# yes, TL1 drivers no) | none (in-band auth only).
SSH_AUTH=password

# --- Metrics ---

# Prometheus HTTP listener for /metrics + /healthz. Use distinct ports across
# instances (e.g. 9100 for 10.50.0.1, 9101 for 10.50.0.2, …). Set empty to
# disable.
METRICS_ADDR=10.50.0.1:9100

# --- Behaviour ---

# Uniform random per-command delay window, in milliseconds. Set both to 0 to
# respond instantly. Production-realistic values are ~50 / 500.
RESPONSE_DELAY_MS_MIN=50
RESPONSE_DELAY_MS_MAX=500

# Per-instance concurrent SSH session cap. At 50k total sessions across 20
# instances, 2500 per instance is the natural cap; double it to 5000 for
# absorbs on polling-burst edges.
MAX_CONCURRENT_SESSIONS=5000

# Longest a session may last before the simulator closes it (Go duration).
# A hang profile adds its hang on top.
MAX_SESSION=5m

# How many devices, in port order from PORT_START, accept sessions: "all" or
# 0..PORT_COUNT. The rest drop connections before the SSH handshake, like the
# refuse profile.
ACTIVE_DEVICES=all

# Directory of per-device command output files, DIR/<hostname>/<slug>.txt.
# Empty disables the feature.
COMMANDS_ROOT=

# --- Fault injection (off by default) ---

# Per-type fault probabilities [0,1], e.g.
#   FAULT_RATES=auth_fail=0.02,disconnect_mid=0.005
# Types: auth_fail, disconnect_mid, slow_response, malformed. Types not
# listed never fire. Empty disables per-type rates.
# Do not combine with FAULT_RATE/FAULT_TYPES below: setting FAULT_RATES and
# either of those is an error and the instance will not start.
FAULT_RATES=

# Legacy form: one probability [0,1] for every type in FAULT_TYPES.
# FAULT_RATE=0.1 with FAULT_TYPES=auth_fail,malformed is the same as
# FAULT_RATES=auth_fail=0.1,malformed=0.1.
FAULT_RATE=0.0

# Comma-separated fault types. Valid values: auth_fail,disconnect_mid,slow_response,malformed
# Leave empty to disable all injection. FAULT_RATE > 0 without any type is a no-op.
FAULT_TYPES=

# --- Device profiles (off by default) ---

# Per-device behaviour for a share of the fleet: profile@percent,...
# e.g. DEVICE_PROFILES=hang:3600s@3%,latency:200-800ms@10%
# Profiles: hang:<duration>, latency:<min>-<max>, refuse, disconnect.
DEVICE_PROFILES=

# Seed deciding which devices DEVICE_PROFILES picks; same seed, same devices.
PROFILE_SEED=42

# --- Admin API (off by default) ---

# Serve the admin API (/admin/v1/*) on METRICS_ADDR, for reading and changing
# faults, profiles, delays, the session cap and active devices at runtime,
# and for live activity. Changes made over the API last until the instance
# restarts; this file is what a restart reads.
ADMIN=false

# If set, every admin API request must send "Authorization: Bearer <token>".
# Strongly recommended when METRICS_ADDR is not loopback. The token is passed
# on the command line, so local users can read it with ps; keep this file
# mode 640 and treat the token as a lab-network guard, not a secret.
ADMIN_TOKEN=

# --- Logging ---

# error | warn | info | debug. Info is appropriate for production.
LOG_LEVEL=info
