# rcfg-sim-ui environment file: /etc/rcfg-sim-ui/rcfg-sim-ui.env
# Installed by `make install-ui` as root:rcfgsim-ui 0640. Keep it that way:
# it holds tokens. Every value maps to an rcfg-sim-ui flag; anything left out
# takes the default in rcfg-sim-ui.service.

# Listen address. Loopback by default: reach it through an SSH tunnel
# (ssh -L 8080:127.0.0.1:8080 <host>). Set a token before binding anything
# else; the UI logs a warning if you do not.
UI_ADDR=127.0.0.1:8080

# If set, the browser needs this token once: open /login?token=<token>, and
# an HttpOnly, SameSite=Strict cookie keeps it signed in. Scripts may send
# Authorization: Bearer <token> instead.
UI_TOKEN=

# Sent to every instance's admin API. Must match ADMIN_TOKEN in the instance
# env files (/etc/rcfg-sim/<IP>.env). Empty if the instances use no token.
ADMIN_TOKEN=

# Instance poll interval (Go duration, at least 500ms).
POLL=2s

# Unit control command. "systemctl" works with the shipped polkit rule; on a
# host without polkit, use "sudo -n systemctl" and the sudoers rule in the
# README.
SYSTEMCTL=systemctl

# error | warn | info | debug
LOG_LEVEL=info
