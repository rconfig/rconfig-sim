# rcfg-sim-ui environment file: /etc/rcfg-sim-ui/rcfg-sim-ui.env
# Installed by `make install-ui` as root:rcfgsim-ui 0640. Keep it that way:
# it holds the login. Every other value maps to an rcfg-sim-ui flag; anything
# left out takes the default in rcfg-sim-ui.service.

# --- Login (required: the UI refuses to start without both) ---

# The one UI user.
UI_USERNAME=admin

# bcrypt hash of the password, never the password itself. Make one with:
#   /opt/rcfg-sim/bin/rcfg-sim-ui hash-password
# (it prompts twice, or reads one line from a pipe) and paste the output
# here. To change the password, put a new hash here and restart the UI.
UI_PASSWORD_HASH=

# Listen address. Loopback by default: reach it through an SSH tunnel
# (ssh -L 8080:127.0.0.1:8080 <host>). It is plain HTTP, so only bind
# anything else on a private lab network; the UI logs a warning if you do.
UI_ADDR=127.0.0.1:8080

# Extra Host header names the UI accepts, comma-separated, when you reach it
# by a name other than its listen address, localhost or 127.0.0.1 (for
# example a lab DNS name). Others get 403.
UI_ALLOWED_HOSTS=

# Instance poll interval (Go duration, at least 500ms).
POLL=2s

# Unit control command. "systemctl" works with the shipped polkit rule; on a
# host without polkit, use "sudo -n systemctl" and the sudoers rule in the
# README.
SYSTEMCTL=systemctl

# error | warn | info | debug
LOG_LEVEL=info

# Builds kept on disk, the live one included (least recently used are
# removed first, never the live one), so switching testbenches can reuse
# one instead of generating. Each 50k-device build takes several GB.
KEEP_BUILDS=3

# Testbench run records kept (oldest removed first).
KEEP_RUNS=200

# How long a testbench start waits for every instance to come up with its
# settings, after any rolling restart, before marking the run failed.
START_TIMEOUT=120s

# Your scenario packages for the Scenarios screen, one folder each
# (scenario.json, manifest.csv, configs/, optional commands/). The shipped
# ones (mesh-campus) are built in. A folder dropped in here shows up on the
# next page load; no restart needed. See the README, "Scenario packages".
SCENARIOS_DIR=/var/lib/rcfg-sim-ui/scenarios
